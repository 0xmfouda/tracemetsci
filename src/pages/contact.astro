---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);
---

<Layout title={t('contact.title')} {lang}>
	<NavBar {lang} />
	<section class="py-24 bg-surface-container-low">
		<div class="max-w-[1440px] mx-auto px-8">
			<div class="text-center mb-16">
				<h1 class="text-5xl font-extrabold text-primary font-headline tracking-tight mb-4">{t('contact.heading')}</h1>
				<p class="text-on-surface-variant text-lg max-w-3xl mx-auto">
					{t('contact.subheading')}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
				<!-- Email Contact Form -->
				<div class="bg-surface-container-lowest rounded-xl p-8 shadow-lg border border-outline-variant/10">
					<h2 class="text-3xl font-bold text-primary mb-6">{t('contact.email.title')}</h2>
					<form id="contact-form" action="https://formsubmit.co/ajax/info@tracemetsci.com" method="POST" class="space-y-6">
						{/* IMPORTANT: After deploying, submit the form once to activate it via the confirmation email from FormSubmit. */}

						{/* Disable CAPTCHA redirect */}
						<input type="hidden" name="_captcha" value="false" />

						{/* Spam Prevention: Honeypot */}
						<input type="text" name="_honey" style="display:none" />

						<div>
							<label for="name" class="block text-sm font-medium text-on-surface">{t('contact.name.label')}</label>
							<div class="mt-1">
								<input
									type="text"
									name="name"
									id="name"
									autocomplete="name"
									class="block w-full rounded-md border-outline-variant/20 bg-surface-container shadow-sm focus:border-primary focus:ring-primary sm:text-sm p-3"
									required
									placeholder={t('contact.name.placeholder')}
								/>
							</div>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-on-surface">{t('contact.email.label')}</label>
							<div class="mt-1">
								<input
									type="email"
									name="email"
									id="email"
									autocomplete="email"
									class="block w-full rounded-md border-outline-variant/20 bg-surface-container shadow-sm focus:border-primary focus:ring-primary sm:text-sm p-3"
									required
									placeholder={t('contact.email.placeholder')}
								/>
							</div>
						</div>
						<div>
							<label for="subject" class="block text-sm font-medium text-on-surface">{t('contact.subject.label')}</label>
							<div class="mt-1">
								<input
									type="text"
									name="_subject"
									id="subject"
									class="block w-full rounded-md border-outline-variant/20 bg-surface-container shadow-sm focus:border-primary focus:ring-primary sm:text-sm p-3"
									required
									placeholder={t('contact.subject.placeholder')}
								/>
							</div>
						</div>
						<div>
							<label for="message" class="block text-sm font-medium text-on-surface">{t('contact.message.label')}</label>
							<div class="mt-1">
								<textarea
									rows="4"
									name="message"
									id="message"
									class="block w-full rounded-md border-outline-variant/20 bg-surface-container shadow-sm focus:border-primary focus:ring-primary sm:text-sm p-3"
									placeholder={t('contact.message.placeholder')}
									required
									minlength="10"></textarea>
							</div>
						</div>
						<div>
							<button
								id="submit-btn"
								type="submit"
								data-label={t('contact.send')}
								data-sending={t('contact.sending')}
								data-error={t('contact.error')}
								class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-on-primary bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors"
							>
								{t('contact.send')}
							</button>
						</div>
					</form>
				</div>

				<!-- WhatsApp -->
				<div class="bg-surface-container-lowest rounded-xl p-8 shadow-lg border border-outline-variant/10 flex flex-col justify-center items-center text-center">
					<h2 class="text-3xl font-bold text-primary mb-6">{t('contact.whatsapp.title')}</h2>
					<p class="text-on-surface-variant mb-6">{t('contact.whatsapp.desc')}</p>
					<a href="https://wa.me/+201130091506" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-medium rounded-md text-white bg-[#25D366] hover:bg-[#128C7E] transition-colors shadow-sm">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-3" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.894 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01s-.52.074-.792.372c-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
						{t('contact.whatsapp.button')}
					</a>
				</div>
			</div>
		</div>
	</section>
	<Footer {lang} />

	<!-- Success Dialog -->
	<dialog id="success-dialog" class="rounded-xl p-8 shadow-2xl bg-surface-container-lowest border border-outline-variant/10 max-w-md w-full backdrop:bg-black/50">
		<div class="flex flex-col items-center text-center gap-4">
			<div class="flex items-center justify-center w-16 h-16 rounded-full bg-primary/10">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
				</svg>
			</div>
			<h3 class="text-2xl font-bold text-primary">{t('contact.dialog.title')}</h3>
			<p class="text-on-surface-variant">{t('contact.dialog.body')}</p>
			<button
				id="close-dialog"
				class="mt-2 px-6 py-2 rounded-md bg-primary text-on-primary font-medium hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
			>
				{t('contact.dialog.close')}
			</button>
		</div>
	</dialog>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const dialog = document.getElementById('success-dialog') as HTMLDialogElement;
	const closeBtn = document.getElementById('close-dialog') as HTMLButtonElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

	const label = submitBtn.dataset.label!;
	const sending = submitBtn.dataset.sending!;
	const errorMsg = submitBtn.dataset.error!;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		submitBtn.disabled = true;
		submitBtn.textContent = sending;

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});

			if (response.ok) {
				form.reset();
				dialog.showModal();
			} else {
				alert(errorMsg);
			}
		} catch {
			alert(errorMsg);
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = label;
		}
	});

	closeBtn.addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});
</script>
