---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { products, analyticalCategories, categoryColors, type Category } from '../../data/products';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const contactUrl = getRelativeLocaleUrl(lang, 'contact');
const productsUrl = getRelativeLocaleUrl(lang, 'products');

// Filter products to only show Analytical Chemistry items
const chemicals = products.filter(p => analyticalCategories.includes(p.category));
const total = chemicals.length;

type FilterKey = 'all' | Category;

const categories: { key: FilterKey; label: string }[] = [
	{ key: 'all', label: t('page.products.filter.all') },
	...analyticalCategories.map(c => ({ key: c, label: t(`page.products.filter.${c}` as any) }))
];
---

<Layout title={t('page.products.analytical-chemistry.title')} {lang}>
	<NavBar {lang} />

	<!-- Page header -->
	<section class="bg-primary pt-20 pb-16 relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-br from-primary via-primary to-primary-container opacity-80"></div>
		<div class="relative z-10 max-w-[1440px] mx-auto px-8">
			<a href={productsUrl} class="inline-flex items-center gap-1 text-secondary-fixed-dim hover:text-white transition-colors text-sm mb-4">
				<span class="material-symbols-outlined text-base">arrow_back</span>
				{t('page.products.back')}
			</a>
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 border border-secondary/40 text-secondary-fixed-dim font-bold text-xs tracking-widest uppercase mb-4 backdrop-blur-sm">
				{t('page.products.cards.analytical-chemistry.title')}
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold text-white font-headline tracking-tight mb-4">
				{t('page.products.analytical-chemistry.heading')}
			</h1>
			<p class="text-slate-300 text-lg max-w-3xl leading-relaxed">
				{t('page.products.analytical-chemistry.subtitle')}
			</p>
		</div>
	</section>

	<!-- Sticky filter bar -->
	<div id="filter-bar" class="sticky top-0 z-40 bg-surface-container-lowest border-b border-outline-variant/20 shadow-sm">
		<div class="max-w-[1440px] mx-auto px-8 py-4 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
			<!-- Search -->
			<div class="relative flex-1 max-w-md">
				<span class="material-symbols-outlined absolute start-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-xl pointer-events-none">search</span>
				<input
					id="product-search"
					type="search"
					placeholder={t('page.products.search.placeholder')}
					class="w-full ps-10 pe-4 py-2.5 rounded-lg bg-surface-container border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-sm"
				/>
			</div>
			<!-- Result counter -->
			<p class="text-sm text-on-surface-variant shrink-0">
				{t('page.products.showing')}
				<span id="result-from" class="font-bold text-on-surface">1</span>–<span id="result-to" class="font-bold text-on-surface">{total}</span>
				{t('page.products.of')}
				<span id="result-total" class="font-bold text-on-surface">{total}</span>
				{t('page.products.results')}
			</p>
		</div>

		<!-- Category tabs -->
		<div class="max-w-[1440px] mx-auto px-8 pb-3 flex gap-2 flex-wrap">
			{categories.map(({ key, label }) => (
				<button
					data-filter-btn={key}
					class:list={[
						'filter-btn px-4 py-1.5 rounded-full text-sm font-medium border transition-all',
						key === 'all'
							? 'bg-primary text-on-primary border-primary'
							: 'bg-transparent text-on-surface-variant border-outline-variant/30 hover:bg-surface-container',
					]}
				>
					{label}
				</button>
			))}
		</div>
	</div>

	<!-- Product grid -->
	<main class="max-w-[1440px] mx-auto px-8 py-12">
		<div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{chemicals.map((p) => {
				const colors = categoryColors[p.category];
				const searchText = `${p.name.en} ${p.name.ar} ${p.code} ${p.cas ?? ''} ${p.applications.join(' ')}`.toLowerCase();
				const categoryLabel = t(`page.products.filter.${p.category}` as any);
				return (
					<article
						data-product-card
						data-category={p.category}
						data-searchtext={searchText}
						class="group flex flex-col bg-surface-container-lowest rounded-xl border border-outline-variant/10 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 overflow-hidden"
					>
						<div class="flex items-start justify-between px-5 pt-5 pb-3 gap-3">
							<span class:list={['inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border', colors.bg, colors.text, colors.border]}>
								{categoryLabel}
							</span>
							<span class="text-xs font-mono text-on-surface-variant/70 shrink-0">{p.code}</span>
						</div>
						<div class="flex-1 px-5 pb-4">
							<h3 class="text-base font-bold text-on-surface mb-1.5 leading-snug group-hover:text-primary transition-colors">
								{p.name[lang]}
							</h3>
							<p class="text-on-surface-variant text-sm leading-relaxed line-clamp-2 mb-4">
								{p.description[lang]}
							</p>
							<dl class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs mb-4">
								{p.cas && (
									<>
										<dt class="text-on-surface-variant font-medium">{t('page.products.cas')}</dt>
										<dd class="text-on-surface font-mono">{p.cas}</dd>
									</>
								)}
								{p.purity && (
									<>
										<dt class="text-on-surface-variant font-medium">{t('page.products.purity')}</dt>
										<dd class="text-on-surface font-mono">{p.purity}</dd>
									</>
								)}
							</dl>
						</div>
						<div class="px-5 pb-5 pt-3 border-t border-outline-variant/10 mt-auto">
							<a href={contactUrl} class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg bg-primary text-on-primary text-sm font-semibold hover:bg-primary/90 transition-all">
								{t('page.products.request_quote')}
								<span class="material-symbols-outlined text-sm">arrow_forward</span>
							</a>
						</div>
					</article>
				);
			})}
		</div>
	</main>
	<Footer {lang} />
</Layout>

<script>
	const searchInput = document.getElementById('product-search') as HTMLInputElement;
	const resultFrom  = document.getElementById('result-from')  as HTMLSpanElement;
	const resultTo    = document.getElementById('result-to')    as HTMLSpanElement;
	const resultTotal = document.getElementById('result-total') as HTMLSpanElement;
	const grid        = document.getElementById('product-grid') as HTMLDivElement;
	const filterBtns  = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
	const allCards    = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));

	let activeCategory = 'all';
	let searchQuery    = '';

	function applyFilters() {
		const visible = allCards.filter((card) => {
			const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
			const matchesSearch   = searchQuery === '' || card.dataset.searchtext!.includes(searchQuery);
			const ok = matchesCategory && matchesSearch;
			card.style.display = ok ? '' : 'none';
			return ok;
		});

		const total = visible.length;
		resultFrom.textContent  = String(total === 0 ? 0 : 1);
		resultTo.textContent    = String(total);
		resultTotal.textContent = String(total);
	}

	function setActiveFilter(category: string) {
		activeCategory = category;
		filterBtns.forEach((b) => {
			const on = b.dataset.filterBtn === category;
			b.classList.toggle('bg-primary', on);
			b.classList.toggle('text-on-primary', on);
			b.classList.toggle('bg-transparent', !on);
			b.classList.toggle('text-on-surface-variant', !on);
		});
	}

	filterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			setActiveFilter(btn.dataset.filterBtn!);
			applyFilters();
		});
	});

	applyFilters();
</script>