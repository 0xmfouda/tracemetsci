---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const productsUrl = getRelativeLocaleUrl(lang, 'products');

const labwaresBase = productsUrl.replace(/\/$/, '');
const categories = [
	{
		key: 'glasswares',
		href: `${labwaresBase}/glasswares`,
		img: '/Homepage Pics/Labware/Glassware.jpg',
		alt: 'Laboratory glassware',
	},
	{
		key: 'instruments',
		href: `${labwaresBase}/instruments`,
		img: '/Homepage Pics/Labware/Instruments.jpg',
		alt: 'Laboratory instruments',
	},
];
---

<Layout title={t('page.products.labwares.title')} {lang}>
	<NavBar {lang} />

	<!-- Page header -->
	<section class="bg-primary pt-20 pb-16 relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-br from-primary via-primary to-primary-container opacity-80"></div>
		<div class="relative z-10 max-w-[1440px] mx-auto px-8">
			<a href={productsUrl} class="inline-flex items-center gap-1 text-secondary-fixed-dim hover:text-white transition-colors text-sm mb-4">
				<span class="material-symbols-outlined text-base">arrow_back</span>
				{t('page.products.back')}
			</a>
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 border border-secondary/40 text-secondary-fixed-dim font-bold text-xs tracking-widest uppercase mb-4 backdrop-blur-sm">
				{t('page.products.cards.labwares.title')}
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold text-white font-headline tracking-tight mb-4">
				{t('page.products.labwares.heading')}
			</h1>
			<p class="text-slate-300 text-lg max-w-3xl leading-relaxed">
				{t('page.products.labwares.subtitle')}
			</p>
		</div>
	</section>

	<!-- Subcategories grid -->
	<section class="py-24 bg-surface-container-low">
		<div class="max-w-[1440px] mx-auto px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				{categories.map(({ key, href, img, alt }) => (
					<a
						href={href}
						class="group bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-outline-variant/10 flex flex-col"
					>
						<div class="h-80 overflow-hidden">
							<img
								src={img}
								alt={alt}
								class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
							/>
						</div>
						<div class="p-8 flex-1 flex flex-col text-center items-center">
							<h3 class="text-3xl font-bold text-primary mb-4">{t(`page.products.cards.${key}.title` as any)}</h3>
							<p class="text-on-surface-variant text-lg leading-relaxed mb-8 flex-1 max-w-md">{t(`page.products.cards.${key}.desc` as any)}</p>
							<div class="px-6 py-2.5 rounded-lg bg-primary text-on-primary text-sm font-semibold group-hover:bg-primary/90 transition-all inline-flex items-center gap-2">
								{t('page.products.cards.browse')}
								<span class="material-symbols-outlined text-sm">arrow_forward</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<Footer {lang} />
</Layout>
