---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale ?? 'en') as Lang;
const t = useTranslations(lang);

const productsBase = getRelativeLocaleUrl(lang, 'products').replace(/\/$/, '');

const cards = [
	{
		key: 'chemicals',
		href: `${productsBase}/chemicals`,
		icon: 'science',
		title: t('page.products.cards.chemicals.title'),
		desc: t('page.products.cards.chemicals.desc'),
		img: 'https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?w=900&q=80',
	},
	{
		key: 'glasswares',
		href: `${productsBase}/glasswares`,
		icon: 'flask',
		title: t('page.products.cards.glasswares.title'),
		desc: t('page.products.cards.glasswares.desc'),
		img: 'https://images.unsplash.com/photo-1567427017947-545c5f8d16ad?w=900&q=80',
	},
	{
		key: 'instruments',
		href: `${productsBase}/instruments`,
		icon: 'precision_manufacturing',
		title: t('page.products.cards.instruments.title'),
		desc: t('page.products.cards.instruments.desc'),
		img: 'https://images.unsplash.com/photo-1576319155264-99536e0be1ee?w=900&q=80',
	},
];
---

<Layout title={t('page.products.title')} {lang}>
	<NavBar {lang} />

	<!-- Page header -->
	<section class="bg-primary pt-20 pb-16 relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-br from-primary via-primary to-primary-container opacity-80"></div>
		<div class="relative z-10 max-w-[1440px] mx-auto px-8">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/20 border border-secondary/40 text-secondary-fixed-dim font-bold text-xs tracking-widest uppercase mb-4 backdrop-blur-sm">
				{t('page.products.badge')}
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold text-white font-headline tracking-tight mb-4">
				{t('page.products.heading')}
			</h1>
			<p class="text-slate-300 text-lg max-w-3xl leading-relaxed">
				{t('page.products.subtitle')}
			</p>
		</div>
	</section>

	<!-- Category cards -->
	<main class="max-w-[1200px] mx-auto px-8 py-16">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{cards.map((c) => (
				<a
					href={c.href}
					class="group flex flex-col bg-surface-container-lowest rounded-2xl border border-outline-variant/10 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 overflow-hidden"
				>
					<div class="h-64 overflow-hidden relative">
						<img
							src={c.img}
							alt={c.title}
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent"></div>
					</div>
					<div class="p-8 flex-1 flex flex-col">
						<h2 class="text-2xl font-bold text-primary font-headline mb-3 group-hover:text-primary-container transition-colors">
							{c.title}
						</h2>
						<p class="text-on-surface-variant leading-relaxed mb-6 flex-1">
							{c.desc}
						</p>
						<span class="inline-flex items-center gap-2 text-primary font-semibold text-sm">
							{t('page.products.cards.browse')}
							<span class="material-symbols-outlined text-base group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">arrow_forward</span>
						</span>
					</div>
				</a>
			))}
		</div>
	</main>

	<Footer {lang} />
</Layout>
