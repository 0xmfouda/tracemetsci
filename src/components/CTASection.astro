---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 bg-primary overflow-hidden relative">
	<div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-primary-container/50 to-transparent"></div>
	<div class="max-w-[1440px] mx-auto px-8 relative z-10">
		<div class="flex flex-col md:flex-row items-center justify-between gap-12">
			<div class="flex-1">
				<h2 class="text-4xl font-bold text-white font-headline mb-6">{t('cta.title')}</h2>
				<p class="text-slate-400 text-xl leading-relaxed max-w-2xl">{t('cta.desc')}</p>
			</div>
			<div class="flex flex-wrap gap-4">
				<button class="px-8 py-4 bg-secondary text-white font-bold rounded-lg shadow-xl shadow-black/20 hover:scale-105 transition-all active:scale-95">{t('cta.configure')}</button>
				<button class="px-8 py-4 bg-white/10 text-white font-bold rounded-lg border border-white/20 hover:bg-white/20 transition-all active:scale-95">{t('cta.catalog')}</button>
			</div>
		</div>
	</div>
</section>
