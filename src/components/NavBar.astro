---
import { useTranslations, type Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeUrl = getRelativeLocaleUrl(lang, '');
const productsUrl = getRelativeLocaleUrl(lang, 'products');
const contactUrl = getRelativeLocaleUrl(lang, 'contact');
---

<header class="w-full top-0 sticky z-50 bg-[#000b1d] border-b border-white/10 shadow-2xl shadow-black/20 font-['Manrope'] antialiased tracking-tight">
	<div class="flex items-center justify-between px-8 py-4 max-w-[1440px] mx-auto">
		<div class="flex items-center gap-8">
			<a href={homeUrl} class="flex items-center gap-3 group cursor-pointer">
				<img
					src="/logo.png"
					alt="Tracemet Scientific logo"
					class="h-12 w-12 object-contain"
				/>
				<span class="text-xl font-bold tracking-tighter text-white uppercase">Tracemet Scientific</span>
			</a>
			<nav class="hidden md:flex items-center gap-6">
				<a href={homeUrl} class="text-slate-300 hover:text-white transition-colors font-semibold">{t('nav.home')}</a>
				<a href={productsUrl} class="text-slate-300 hover:text-white transition-colors">{t('nav.products')}</a>
			</nav>
		</div>
		<div class="flex items-center gap-4">
			<a href={contactUrl}>
				<button class="px-5 py-2.5 text-slate-300 hover:text-white transition-all duration-300 active:scale-95 text-sm font-medium">{t('nav.contact')}</button>
			</a>
			<a href={contactUrl}>
<button class="px-6 py-2 leading-tight text-center bg-gradient-to-br from-secondary to-on-secondary-container text-white font-semibold rounded-lg shadow-lg shadow-black/20 hover:brightness-110 active:scale-95 transition-all duration-300 text-sm">Customize your Reagents, QC,<br />CRM, and Calibration Standards</button>			</a>
		</div>
	</div>
</header>
