---
import { useTranslations, getAlternateUrl, type Lang } from "../i18n/utils";
import { languages } from "../i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const altUrl = getAlternateUrl(lang, currentPath);
const altLang = lang === "en" ? "ar" : "en";
---

<footer
    class="w-full mt-auto py-12 bg-slate-950 dark:bg-slate-950 border-t border-slate-800 font-['Inter'] text-sm tracking-wide"
>
    <div
        class="flex flex-col md:flex-row justify-between items-start px-12 max-w-[1440px] mx-auto gap-12"
    >
        <div class="space-y-6">
            <div class="flex items-center gap-3">
                <img
                    src="/logo.png"
                    alt="Tracemet Scientific logo"
                    class="h-12 w-12 object-contain"
                />
                <span
                    class="text-lg font-semibold text-slate-100 uppercase tracking-tighter"
                    >Tracemet Scientific</span
                >
            </div>
            <p class="text-slate-500 max-w-xs leading-relaxed">
                {t("footer.desc")}
            </p>
            <div class="flex gap-4">
                <a
                    href="#"
                    class="w-8 h-8 rounded bg-white/5 flex items-center justify-center text-slate-400 hover:text-secondary transition-colors"
                >
                    <span class="material-symbols-outlined text-lg">share</span>
                </a>
                <a
                    href="#"
                    class="w-8 h-8 rounded bg-white/5 flex items-center justify-center text-slate-400 hover:text-secondary transition-colors"
                >
                    <span class="material-symbols-outlined text-lg">mail</span>
                </a>
                <a
                    href="#"
                    title="LinkedIn"
                    class="w-8 h-8 rounded bg-white/5 flex items-center justify-center text-slate-400 hover:text-secondary transition-colors"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path
                            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                        ></path>
                    </svg>
                </a>
                <a
                    href="#"
                    title="Facebook"
                    class="w-8 h-8 rounded bg-white/5 flex items-center justify-center text-slate-400 hover:text-secondary transition-colors"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path
                            d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"
                        ></path>
                    </svg>
                </a>
            </div>
            <div class="space-y-2 mt-4 text-slate-500">
                <p class="flex items-center gap-2">
                    <span
                        class="material-symbols-outlined text-sm text-secondary"
                        >mail</span
                    >
                    <a
                        href="mailto:info@tracemetsci.com"
                        class="hover:text-secondary transition-colors"
                        >info@tracemetsci.com</a
                    >
                </p>
                <p class="flex items-center gap-2">
                    <span
                        class="material-symbols-outlined text-sm text-secondary"
                        >call</span
                    >
                    <a
                        href="tel:+201130091506"
                        class="hover:text-secondary transition-colors"
                        >+201130091506</a
                    >
                </p>
                <p class="flex items-center gap-2">
                    <span
                        class="material-symbols-outlined text-sm text-secondary"
                        >call</span
                    >
                    <a
                        href="tel:+201130091508"
                        class="hover:text-secondary transition-colors"
                        >+201130091508</a
                    >
                </p>
                <p class="flex items-center gap-2">
                    <span
                        class="material-symbols-outlined text-sm text-secondary"
                        >location_on</span
                    >
                    <span>{t("footer.office")}</span>
                </p>
            </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-12">
            <div class="space-y-4">
                <h4
                    class="text-white font-bold uppercase text-[10px] tracking-widest"
                >
                    {t("footer.solutions")}
                </h4>
                <ul class="space-y-2 text-slate-500">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.chromatography")}</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.inorganic")}</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.custom")}</a
                        >
                    </li>
                </ul>
            </div>
            <div class="space-y-4">
                <h4
                    class="text-white font-bold uppercase text-[10px] tracking-widest"
                >
                    {t("footer.company")}
                </h4>
                <ul class="space-y-2 text-slate-500">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.about")}</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.support")}</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.global")}</a
                        >
                    </li>
                </ul>
            </div>
            <div class="space-y-4">
                <h4
                    class="text-white font-bold uppercase text-[10px] tracking-widest"
                >
                    {t("footer.legal")}
                </h4>
                <ul class="space-y-2 text-slate-500">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.privacy")}</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.terms")}</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#735a2e] transition-colors"
                            >{t("footer.accreditation")}</a
                        >
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div
        class="max-w-[1440px] mx-auto px-12 mt-12 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-xs"
    >
        <p>{t("footer.copyright")}</p>
        <div class="flex items-center gap-6">
            <!-- Language switcher -->
            <div class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">language</span>
                <span class="font-semibold text-slate-300"
                    >{languages[lang]}</span
                >
                <span class="mx-1 text-slate-600">|</span>
                <a href={altUrl} class="hover:text-secondary transition-colors"
                    >{languages[altLang]}</a
                >
            </div>
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm"
                    >verified_user</span
                >
                {t("footer.secure")}
            </span>
        </div>
    </div>
</footer>
