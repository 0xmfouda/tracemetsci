---
import { useTranslations, type Lang } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = [
	{
		key: 'chromatography',
		img: 'https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?w=600&q=80',
		alt: 'Chromatography laboratory equipment',
	},
	{
		key: 'inorganic',
		img: 'https://images.unsplash.com/photo-1576319155264-99536e0be1ee?w=600&q=80',
		alt: 'Inorganic elemental analysis instrument',
	},
	{
		key: 'icp',
		img: 'https://images.unsplash.com/photo-1507413245164-6160d8298b31?w=600&q=80',
		alt: 'ICP-MS plasma spectroscopy system',
	},
	{
		key: 'electrochemical',
		img: 'https://images.unsplash.com/photo-1559757175-0eb30cd8c063?w=600&q=80',
		alt: 'Electrochemical measurement system',
	},
	{
		key: 'powders',
		img: 'https://images.unsplash.com/photo-1603126857599-f6e157fa2fe6?w=600&q=80',
		alt: 'High-purity chemical powders',
	},
] as const;
---

<section class="py-24 bg-surface-container-low">
	<div class="max-w-[1440px] mx-auto px-8">
		<div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
			<div>
				<h2 class="text-4xl font-extrabold text-primary font-headline tracking-tight mb-4">{t('products.title')}</h2>
				<p class="text-on-surface-variant text-lg max-w-2xl">{t('products.subtitle')}</p>
			</div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-5 gap-6">
			{products.map(({ key, img, alt }) => (
				<a
					href={`${getRelativeLocaleUrl(lang, 'products').replace(/\/$/, '')}/chemicals?category=${key}`}
					class="group bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 border border-outline-variant/10"
				>
					<div class="h-64 overflow-hidden">
						<img
							src={img}
							alt={alt}
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
						/>
					</div>
					<div class="p-6">
						<h3 class="text-xl font-bold text-primary mb-3">{t(`products.${key}.title` as any)}</h3>
						<p class="text-on-surface-variant text-sm leading-relaxed">{t(`products.${key}.desc` as any)}</p>
					</div>
				</a>
			))}
		</div>
	</div>
</section>
