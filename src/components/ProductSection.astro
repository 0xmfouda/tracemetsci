	{
		key: 'electrochemical',
		img: 'https://lh3.googleusercontent.com/aida/ADBb0ui56K-gT20e1KEpvG5zrSfMK-sRnuT23XqggYJlU3nbpywYTUvmf4otPSi_dcZnhth04nYjlIk6pGY727_CCgEBoxIM8TD3Dkm7-bDGbPTKwN7_O9wy8itUCM00UdutF6Az8OhXXwc2eDD78kKBvn7Gjcj83iLksU2xgPMpbmS8-9YJRuw5I224Ds8UNdce3jA6bcrzmsAuPEc5afvCUTFqtgynN0qLk1tKJOTGA_jJ6ISCtSvED9JJuziCt-fymJQ6K5Uf3KBGPA',
