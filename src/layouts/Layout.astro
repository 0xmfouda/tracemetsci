---
import type { Lang } from '../i18n/utils';

interface Props {
	title?: string;
	lang?: Lang;
}

const { title = 'TraceMet Science', lang = 'en' } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html class="light" lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		{lang === 'ar' && <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />}
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
		<script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
		<script is:inline id="tailwind-config">
			tailwind.config = {
				darkMode: "class",
				theme: {
					extend: {
						colors: {
							"on-error": "#ffffff",
							"surface-dim": "#d8dadd",
							"on-secondary-fixed-variant": "#594319",
							"surface-container": "#eceef1",
							"inverse-primary": "#adc8f3",
							"inverse-surface": "#2e3133",
							"surface-bright": "#f8f9fd",
							"on-tertiary": "#ffffff",
							"inverse-on-surface": "#eff1f4",
							"secondary": "#735a2e",
							"outline-variant": "#c4c6cf",
							"on-primary-container": "#708ab2",
							"on-tertiary-container": "#738ca4",
							"error": "#ba1a1a",
							"primary-container": "#002244",
							"on-primary-fixed": "#001c3a",
							"on-background": "#191c1f",
							"surface": "#f8f9fd",
							"surface-container-high": "#e6e8ec",
							"on-surface": "#191c1f",
							"on-primary": "#ffffff",
							"primary-fixed-dim": "#adc8f3",
							"surface-container-highest": "#e1e2e6",
							"on-tertiary-fixed-variant": "#31495e",
							"on-tertiary-fixed": "#011d31",
							"on-secondary-fixed": "#271900",
							"on-secondary-container": "#785f32",
							"on-secondary": "#ffffff",
							"surface-container-lowest": "#ffffff",
							"tertiary": "#000d19",
							"tertiary-fixed": "#cde5ff",
							"tertiary-container": "#082438",
							"error-container": "#ffdad6",
							"outline": "#74777f",
							"primary-fixed": "#d4e3ff",
							"primary": "#000b1d",
							"secondary-fixed-dim": "#e3c28c",
							"tertiary-fixed-dim": "#b0c9e3",
							"surface-variant": "#e1e2e6",
							"surface-tint": "#456085",
							"secondary-fixed": "#ffdea9",
							"on-error-container": "#93000a",
							"on-primary-fixed-variant": "#2d486c",
							"background": "#f8f9fd",
							"secondary-container": "#fddba3",
							"surface-container-low": "#f2f4f7",
							"on-surface-variant": "#43474e"
						},
						fontFamily: {
							"headline": ["Manrope"],
							"body": ["Inter"],
							"label": ["Inter"]
						},
						borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
					},
				},
			}
		</script>
		<style>
			html, body { margin: 0; width: 100%; height: 100%; }
			.glass-panel {
				background: rgba(255, 255, 255, 0.05);
				backdrop-filter: blur(24px);
				-webkit-backdrop-filter: blur(24px);
			}
			.hero-gradient {
				background: linear-gradient(to right, rgba(0, 11, 29, 0.92) 0%, rgba(0, 11, 29, 0.7) 40%, rgba(0, 34, 68, 0.4) 100%);
			}
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
			}
			/* Arabic font override */
			:lang(ar), :lang(ar) * {
				font-family: 'Cairo', sans-serif !important;
				letter-spacing: 0 !important;
			}
		</style>
	</head>
	<body class="bg-surface text-on-surface font-body selection:bg-secondary/30">
		<slot />
	</body>
</html>
